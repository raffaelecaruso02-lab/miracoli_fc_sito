# Copia questo file in `.env.local` e incolla i valori del tuo progetto
# Supabase (Project Settings → API). Entrambi finiscono nel bundle del
# browser: è normale, sono chiavi pubbliche. È RLS a proteggere i dati.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# NON mettere mai qui la service_role key: bypassa ogni policy.
